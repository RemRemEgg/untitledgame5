[sub_resource type="Shader" id="Shader_q682g"]
code = "shader_type spatial;
render_mode unshaded;

uniform sampler2D tex : source_color, filter_nearest, repeat_enable;

varying vec3 modulo;

void vertex() {
	modulo = NORMAL;
}

void fragment() {
	vec4 frag = texture(tex, UV*vec2(48.0, 32.0));
	ALBEDO = frag.rgb*0.5 + modulo*0.25;
	ALPHA = max(0.0, 0.35-frag.r*0.5);
}
"

