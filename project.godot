; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="untitledgame5"
run/main_scene="uid://8lopb0c5ctb2"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60

[autoload]

Console="*uid://cldhaugncyfiw"
Game="*uid://bx1r7l6g7spmp"
Network="*uid://bxh4sx5jp18gi"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/shadowed_global_identifier=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/native_method_override=1

[editor_plugins]

enabled=PackedStringArray("res://addons/ridiculous_coding/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://game/levels/": "yellow",
"res://game/procedurals/": "teal",
"res://shaders/": "blue",
"res://textures/": "purple",
"res://textures/editor/": "red",
"res://ui/": "green"
}

