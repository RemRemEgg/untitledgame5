[sub_resource type="GDScript" id="GDScript_pc4cn"]
resource_name = "shockwave"
script/source = "extends MeshInstance3D

func _ready() -> void:
	var tween := create_tween()
	var end_scale := scale
	scale = Vector3.ONE * 0.01
	tween.tween_property(self, ^\"scale\", end_scale, 0.25)
	await tween.finished
	queue_free()
"

